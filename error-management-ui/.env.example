# Postgres connection string used by Prisma (see root docker-compose.yml for local defaults)
DATABASE_URL="postgresql://eml:eml@localhost:5432/eml"

# Secret used by Auth.js to sign/encrypt session and CSRF tokens — generate with `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-generated-secret"

# Email for the first Admin account, created by `npm run db:seed` (no self-signup — this is how the first Admin gets in)
ADMIN_EMAIL="admin@example.com"

# Password for the first Admin account, created by `npm run db:seed` — change it after first login
ADMIN_PASSWORD="replace-with-a-strong-password"
