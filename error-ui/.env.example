# Base URL of the error-management-ui service this app calls for error lookups (e.g.
# http://error-management-ui:3000 inside docker-compose's network, or http://localhost:3000
# for local dev)
MANAGEMENT_API_URL="http://localhost:3000"

# System-level API key (not a per-Application key) sent as `Authorization: Bearer <key>` to
# error-management-ui's GET /api/v1/lookup; create one from its /system-api-keys admin page
EML_SYSTEM_API_KEY=""
